{
  "compilerOptions": {
    "lib": [
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "removeComments": true,
    "declaration": true,
    "types": ["jest", "jest-environment-puppeteer", "expect-puppeteer"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/test/**/*.ts",
    "src/index.ts"
  ]
}
