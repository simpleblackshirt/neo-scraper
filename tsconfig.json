{
  "compilerOptions": {
    "lib": [
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["jest", "jest-environment-puppeteer", "expect-puppeteer"],
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
